# Gemini API Key (GLOBAL SECRET - pre-configured in environment for full-stack server)
# Global key used by the backend for all users; a per-user key may override it via admin settings.
GEMINI_API_KEY=

# Endereco do backend de IA (somente para build estatico, ex.: GitHub Pages).
# Deixe vazio quando o frontend for servido pelo proprio backend.
# Exemplo: https://viabiliza-api.seu-orgao.gov.br
VITE_AI_API_URL=

# Porta do servidor (padrao 3000). Em Docker/Cloud Run normalmente vem do ambiente.
PORT=3000

# Origens autorizadas a chamar a API de IA (separadas por virgula).
# Necessario quando o site e estatico (ex.: GitHub Pages) e o backend fica em outro dominio.
CORS_ORIGINS=https://diegofmartins.github.io

# Opcional: sobrescreve a chave web publica usada para validar o login no backend.
# Normalmente nao e necessario (vem do firebase-applet-config.json).
FIREBASE_API_KEY=

# Google Chat Webhook URL for notifications
VITE_GOOGLE_CHAT_WEBHOOK_URL=
