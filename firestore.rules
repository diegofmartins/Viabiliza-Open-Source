rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDefaultMaster() {
      return isAuthenticated() && 
             'email' in request.auth.token && 
             request.auth.token.email.lower() == "diego.martins@cmc.pr.gov.br";
    }

    function isMaster() {
      return isDefaultMaster() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master'
      );
    }

    function isApproved() {
      return isDefaultMaster() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    match /users/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isDefaultMaster() || isMaster());
      allow list: if isDefaultMaster() || isMaster();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isMaster() || (isAuthenticated() && request.auth.uid == uid && request.resource.data.role == 'user');
      allow delete: if isAuthenticated() && (
        isDefaultMaster() || isMaster() || 
        (resource.data.email.lower() == request.auth.token.email.lower())
      );
    }

    match /etps/{etpId} {
      allow get, list: if isAuthenticated() && (isDefaultMaster() || isMaster() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isDefaultMaster() || isMaster());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isDefaultMaster() || isMaster());
    }

    match /config/system {
      allow read: if isMaster();
      allow write: if isMaster();
    }

    match /settings/{docId} {
      allow read: if isMaster();
      allow write: if isMaster();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
